# Copy to .env for local development. The defaults match docker-compose.yml.

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=

# --- Postgres (Supabase in production) -------------------------------------
DATABASE_URL=postgresql://adesc:adesc@localhost:54322/adesc

# --- Redis (Celery broker + job-event pub/sub) -----------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (Cloudflare R2 in production, MinIO locally) -----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
R2_BUCKET=adesc

# --- Auth (Supabase) -------------------------------------------------------
# Project URL; the backend derives the JWKS endpoint from it to verify tokens.
SUPABASE_URL=
# Only for legacy symmetric projects — omit when using JWKS.
# SUPABASE_JWT_SECRET=
# Override the derived JWKS endpoint, if you need to.
# SUPABASE_JWKS_URL=

# DEVELOPMENT ONLY: accept every request as this user and skip auth entirely.
# Never set this in a deployed environment. See src/auth.py.
# ADESC_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# --- API -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
# Vercel preview deploys get generated hostnames that cannot be listed above.
# Set this on staging only; production should keep an exact origin list.
# ALLOWED_ORIGIN_REGEX=^https://adesc-[a-z0-9-]+\.vercel\.app$
ADESC_LOG_LEVEL=INFO
ADESC_SCRATCH_ROOT=/tmp/adesc-jobs
