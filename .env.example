# Copy to .env for local development. The defaults match docker-compose.yml.

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=

# --- Postgres (Supabase in production) -------------------------------------
DATABASE_URL=postgresql://adesc:adesc@localhost:54322/adesc

# --- Redis (Celery broker + job-event pub/sub) -----------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (Cloudflare R2 in production, MinIO locally) -----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
R2_BUCKET=adesc

# --- Auth (Supabase) -------------------------------------------------------
# Project URL and the JWKS/issuer used to verify browser tokens.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
# Leave unset to require real tokens. See src/auth.py.
# ADESC_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# --- API -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
ADESC_LOG_LEVEL=INFO
ADESC_SCRATCH_ROOT=/tmp/adesc-jobs
